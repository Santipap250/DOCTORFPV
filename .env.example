# ConfigDoctor — environment variables
# Copy this file to .env and fill in the values before running locally.
# In production (Render, Docker, etc.) set these as real environment
# variables instead of committing a .env file.

# Required. Signs sessions + CSRF tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Base URL used for sitemap.xml, robots.txt, and OG/canonical
# tags. Defaults to the Render URL if unset.
# BASE_URL=https://configdoctor.onrender.com

# Optional. Set to 1 only for local HTTP development — allows non-Secure
# session cookies. Never set this in production (HTTPS deployments).
# FORCE_INSECURE=0

# Optional. Trust X-Forwarded-For from a reverse proxy (Render, etc.)
# for correct client IP in rate limiting. Default: 1
# TRUST_PROXY=1

# Optional. Flask debug mode — never enable in production.
# FLASK_DEBUG=0

# Optional. Redis connection string for distributed rate limiting across
# multiple workers/instances. Falls back to in-memory (single-process)
# rate limiting if unset.
# REDIS_URL=redis://localhost:6379/0

# Optional. SQLite path for the community database. COMMUNITY_DB_PATH is
# the preferred name going forward; DATABASE_PATH is still read for
# backward compatibility if COMMUNITY_DB_PATH is unset. Defaults to
# data/community.db if neither is set.
# COMMUNITY_DB_PATH=data/community.db
